# Ye sab Vercel > Project > Settings > Environment Variables me daalo.
# (Local chalane ke liye is file ko ".env" naam se copy kar sakte ho.)

# Aapka final domain (canonical URL, sitemap.xml, robots.txt ke liye).
# Khali chhodoge to Vercel ka *.vercel.app domain apne aap use hoga.
REACT_APP_SITE_URL=https://www.tirupatiinfracare.com

# Cloudinary > Dashboard par "Cloud name"
REACT_APP_CLOUDINARY_CLOUD_NAME=

# (Optional) Customer ki leakage photos ke liye unsigned preset (sirf images, 5 MB)
REACT_APP_CLOUDINARY_LEAD_PRESET=

# (Optional) Admin page me pehle se bhare hue aayenge — secret nahi hain.
# Admin upload preset aur GitHub token yahan MAT daalna; wo admin page me hi bharna.
REACT_APP_GITHUB_OWNER=
REACT_APP_GITHUB_REPO=
REACT_APP_GITHUB_BRANCH=main
